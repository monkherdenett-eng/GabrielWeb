# Google Sheets тохиргоо
SPREADSHEET_ID=your_google_spreadsheet_id_here
SHEET_NAME=Бүртгэл

# Google Service Account credentials.json файлын агуулгыг base64 болгож хадгална.
# Жишээ: $b64 = [Convert]::ToBase64String([IO.File]::ReadAllBytes("credentials.json"))
GOOGLE_CREDENTIALS_B64=base64_encoded_service_account_json_here

# byl.mn төлбөрийн API
BYL_TOKEN=your_byl_api_token
BYL_PROJECT_ID=547
BYL_PRICE_ID=1555
# byl.mn webhook signature secret (байх ёстой — webhook-г баталгаажуулна)
BYL_WEBHOOK_SECRET=your_webhook_secret

# /api/debug endpoint-ыг хамгаалах токен (?token=... query param)
ADMIN_DEBUG_TOKEN=long_random_string

# Local dev үед Flask debugger асаах эсэх (production-д "0" байна)
FLASK_DEBUG=0
